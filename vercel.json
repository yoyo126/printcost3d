{
  "functions": { "api/bambu.js": { "maxDuration": 30 }, "api/push.js": { "maxDuration": 30 } },
  "crons": [{ "path": "/api/backup", "schedule": "0 3 * * 1" }],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
